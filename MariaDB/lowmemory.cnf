# MariaDB Konfiguration für Systeme mit wenig RAM (unter 512 MB).
# Alle Puffer und Caches sind auf ein Minimum reduziert.

[client]
port   = 3306
socket = /var/run/mysqld/mysqld.sock

[mysqld]
# -- Basis ----------------------------------------------------------------
pid-file        = /var/run/mysqld/mysqld.pid
socket          = /var/run/mysqld/mysqld.sock
port            = 3306
basedir         = /usr
datadir         = /var/lib/mysql
tmpdir          = /tmp
lc_messages_dir = /usr/share/mysql
lc_messages     = en_US

skip-external-locking
# DNS-Lookup bei Verbindungen überspringen (schnellere Verbindungen)
skip-name-resolve

# Performance Schema deaktivieren – größte Einzelersparnis (50–400 MB)
performance_schema = OFF

# -- Verbindungen ---------------------------------------------------------
max_connections      = 10
connect_timeout      = 5
# Idle-Verbindungen nach 3 Minuten freigeben
wait_timeout         = 180
max_allowed_packet   = 16M
thread_cache_size    = 0
# Puffer pro Verbindung klein halten (werden mit max_connections multipliziert)
sort_buffer_size     = 32K
join_buffer_size     = 128K
read_buffer_size     = 8K
read_rnd_buffer_size = 8K
net_buffer_length    = 1K

# -- Temporäre Tabellen ---------------------------------------------------
bulk_insert_buffer_size = 0
tmp_table_size          = 1K
max_heap_table_size     = 16K

# -- MyISAM ---------------------------------------------------------------
myisam_recover_options  = BACKUP
key_buffer_size         = 1M
# Korrektur: Standard wäre 512M – für Low-Memory deutlich reduzieren
myisam_sort_buffer_size = 4M
table_open_cache        = 400
concurrent_insert       = 2

# -- Aria (MariaDB-spezifisch) --------------------------------------------
# Standard ist 128M – auf Minimum reduzieren
aria_pagecache_buffer_size = 4M

# -- Query Cache ----------------------------------------------------------
# Seit MariaDB 10.6 deprecated, vollständig deaktivieren
query_cache_size = 0
query_cache_type = 0

# -- Logging und Replikation ----------------------------------------------
# Binary-Logging deaktivieren (kein Replikationsbedarf, spart I/O und RAM)
disable_log_bin = 1

slow_query_log_file = /var/log/mysql/mariadb-slow.log
long_query_time     = 10

# -- InnoDB ---------------------------------------------------------------
default_storage_engine        = InnoDB
innodb_buffer_pool_size       = 10M
innodb_log_buffer_size        = 512K
innodb_file_per_table         = 1
innodb_open_files             = 400
innodb_io_capacity            = 400
innodb_flush_method           = O_DIRECT
# Kein Flush bei jedem Commit – besser für Performance auf schwacher Hardware
innodb_flush_log_at_trx_commit = 0
# Adaptiver Hash-Index spart InnoDB-Pufferspeicher
innodb_adaptive_hash_index    = OFF
innodb_read_io_threads        = 1
innodb_write_io_threads       = 1

[mysqldump]
quick
quote-names
max_allowed_packet = 16M

[mysql]
no-auto-rehash

[isamchk]
key_buffer = 4M
